# Copy to .env.local and fill in. Every value is OPTIONAL — the site runs
# correctly with none of them set, and each one turns on a feature when added.

# Production origin. Used for canonical URLs, sitemap.xml, robots.txt and JSON-LD.
# Set this before launch or those URLs will point at the placeholder domain.
NEXT_PUBLIC_SITE_URL=https://vaporpulseirving.com

# Google Place ID for the Irving store.
# The confirmed ID (ChIJa5iB42uDToYRg7jh2Z3Xzbs) is already the default in
# src/data/business.ts, so this only needs setting to OVERRIDE it — for example
# if the Google listing is ever recreated.
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Google Maps Embed API key.
# With it, the store map uses the official Embed API. Without it, the map falls
# back to the keyless embed, which works fine — this is purely an upgrade.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
